NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

DB_PASSWORD=

# Server only: staff Auth administration and public booking submission.
SUPABASE_SECRET_KEY=

# Enable only behind a proxy that replaces untrusted forwarding headers. Vercel is detected automatically.
RESERVATION_TRUST_PROXY=0

# R2 editorial-media uploads. Apply the R2 media migration before use.
# Server-only credentials: never use NEXT_PUBLIC_ prefixes.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public delivery origin, e.g. https://media.example.com (not the S3 endpoint).
R2_PUBLIC_BASE_URL=
